
// BEGIN DELTA SWITCH2KIT REGISTRATION (generated by Integrations/Switch2Kit/configure.py)
// A same-file extension deliberately uses DeltaCore's private registry. This
// avoids fake GCController notifications or an application-only controller list.
public extension ExternalGameControllerManager
{
    func registerSwitch2Controller(_ controller: GameController, assignPlayerIndex: Bool)
    {
        dispatchPrecondition(condition: .onQueue(.main))
        guard !self.connectedControllers.contains(where: { $0 === controller }) else { return }
        if assignPlayerIndex && self.automaticallyAssignsPlayerIndexes
        {
            let used = Set(self.connectedControllers.compactMap(\.playerIndex))
            controller.playerIndex = (0..<4).first { !used.contains($0) }
        }
        self.connectedControllers.append(controller)
        NotificationCenter.default.post(name: .externalGameControllerDidConnect, object: controller)
    }

    func unregisterSwitch2Controller(_ controller: GameController)
    {
        dispatchPrecondition(condition: .onQueue(.main))
        self.remove(controller)
    }
}
// END DELTA SWITCH2KIT REGISTRATION
